APP_NAME="PacificEcommerce"
APP_ENV=production
#APP_KEY: GENERAR_CON_PHP_ARTISAN_KEY:GENERATE
APP_KEY=
APP_DEBUG=false
APP_URL=https://epulse.pro

# Frontend servido desde el mismo dominio (Laravel + build del frontend en public/)
FRONTEND_URL=https://epulse.pro

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=CAMBIAR_NOMBRE_BD
DB_USERNAME=CAMBIAR_USUARIO_BD
DB_PASSWORD=CAMBIAR_PASSWORD_BD

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.epulse.pro
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email Configuration - Gmail SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=admpacificecommerce@gmail.com
MAIL_PASSWORD=***REMOVED_MAIL_PASSWORD***
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admpacificecommerce@gmail.com" 
MAIL_FROM_NAME="Pacific Ecommerce"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# JWT Configuration - Generar nuevo con: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=480
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=false
JWT_BLACKLIST_GRACE_PERIOD=0

# Auth Configuration
AUTH_GUARD=api

# Google reCAPTCHA v2 (checkbox)
RECAPTCHA_SITE_KEY=6Ld60EctAAAAAPshho6XBXoeInrHUhL6yh9Sj8KW
RECAPTCHA_SECRET_KEY=***REMOVED_RECAPTCHA_SECRET***

