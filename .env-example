APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:***REMOVED_APP_KEY***
APP_DEBUG=false
APP_URL=https://pacificecommerce.shop

# Frontend URL para CORS
FRONTEND_URL=https://pacific-ecommerce-ui.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pacific_ecommerce
DB_USERNAME=postgres
DB_PASSWORD=112711

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.pacificecommerce.shop
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email Configuration - Gmail SMTP (Testing/Development)
# How to generate App Password:
# 1. Enable 2FA on your Google Account: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password (no spaces) in MAIL_PASSWORD
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=admpacificecommerce@gmail.com
MAIL_PASSWORD=***REMOVED_MAIL_PASSWORD***
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admpacificecommerce@gmail.com"
MAIL_FROM_NAME="Pacific Ecommerce"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT Configuration
JWT_SECRET=***REMOVED_JWT_SECRET***
JWT_TTL=480
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=false
JWT_BLACKLIST_GRACE_PERIOD=0

# Auth Configuration
AUTH_GUARD=api

# ALTCHA CAPTCHA
ALTCHA_HMAC_KEY=change-this-very-long-random-secret
ALTCHA_EXPIRE_SECONDS=300
ALTCHA_MAX_NUMBER=100000
